{
  "name": "@cypress-tools/mysql",
  "version": "1.5.0",
  "description": "Cypress plugin for MySQL — query, seed and clean your database directly from your E2E tests (mysql2, TypeScript ready).",
  "keywords": [
    "cypress",
    "cypress-plugin",
    "mysql",
    "mysql2",
    "e2e",
    "testing"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "cy:open": "cypress open",
    "cy:open8": "cypress open --env MYSQL_PORT=3308",
    "cy:run": "cypress run",
    "cy:run8": "cypress run --env MYSQL_PORT=3308"
  },
  "dependencies": {
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.13.4",
    "cypress": "16.0.0",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "dayjs": "1.11.23"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeJeanbono/cypress-mysql.git"
  },
  "author": "Jean-Michel LECLERCQ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LeJeanbono/cypress-mysql/issues"
  },
  "homepage": "https://github.com/LeJeanbono/cypress-mysql#readme",
  "publishConfig": {
    "access": "public"
  }
}
