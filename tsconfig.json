{
    "compilerOptions": {
        "outDir": "dist",
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "sourceMap": true,
        "declaration": true,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}